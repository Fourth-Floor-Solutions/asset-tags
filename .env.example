# Asset Tags: server settings and secrets.
# Everything else (organisation name, label wording, support contact, Hudu
# address, sign-in domains, printers) is set in the app under Settings.

# The address people reach the app on. It's printed into every QR code, so
# choose it before printing real tags.
PUBLIC_BASE_URL=https://assets.example.com

# Your reverse proxy's IP: the only address allowed to pass on the client's IP.
FORWARDED_ALLOW_IPS=127.0.0.1

# Port on the Docker host that the app is published on.
HOST_PORT=8080

# Where users can get the source code (AGPL). Change it if you run a modified copy.
# SOURCE_URL=https://github.com/Fourth-Floor-Solutions/asset-tags

# First-boot admin account (username "admin"). Change the password after signing in.
ADMIN_PASSWORD=
ADMIN_EMAIL=

# Hudu API key (optional). The Hudu address goes in Settings.
HUDU_API_KEY=

# Microsoft Entra ID sign-in (optional).
# Redirect URI to register: <PUBLIC_BASE_URL>/auth/callback
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# Local development over plain http only.
# COOKIE_INSECURE=1
