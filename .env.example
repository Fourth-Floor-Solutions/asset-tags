# TagDesk: server settings.
# Everything else (organisation, label wording, support contact, printers,
# Hudu address and API key, Microsoft sign-in) is set in the app under Settings.

# The address people reach the app on. It's printed into every QR code, so
# choose it before printing real tags.
PUBLIC_BASE_URL=https://assets.example.com

# Your reverse proxy's IP: the only address allowed to pass on the client's IP.
FORWARDED_ALLOW_IPS=127.0.0.1

# Port on the Docker host that the app is published on.
HOST_PORT=8080

# First-boot admin account (username "admin"). Change the password after signing in.
ADMIN_PASSWORD=
ADMIN_EMAIL=

# Optional: the key that encrypts secrets saved in Settings. If unset, one is
# created in data/secret.key on first use. Keep it (and back it up) with data/.
# TAGDESK_SECRET_KEY=

# Optional overrides. Anything set here takes priority over Settings and
# can't be edited in the app. Leave them unset to manage everything in Settings.
# HUDU_API_KEY=
# ENTRA_TENANT_ID=
# ENTRA_CLIENT_ID=
# ENTRA_CLIENT_SECRET=
# SOURCE_URL=https://github.com/Fourth-Floor-Solutions/tagdesk

# How often to check Hudu for archived devices and retire their tags, in minutes (0 = off).
# HUDU_ARCHIVE_CHECK_MINUTES=60

# Daily database copies kept in the data folder's backups/ (0 = off).
# BACKUP_KEEP=7

# Application log level (sign-ins, tag events, settings changes, printer and Hudu errors);
# see them with `docker compose logs`. DEBUG, INFO (default), WARNING or ERROR.
# LOG_LEVEL=INFO

# Local development over plain http only.
# COOKIE_INSECURE=1
